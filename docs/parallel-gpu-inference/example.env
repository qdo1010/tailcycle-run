# Copy, fill in, then `source my.env` before running the scripts.
export TC_REPO=/path/to/tailcyclenet            # checkout with `pixi install` already done
export TC_PIXI=pixi                             # or the full path to the pixi binary
export TC_POSE=/path/to/pose.pth                # pose run folder or packaged .pth
export TC_DETECTOR=/path/to/detector.pth        # detector run folder or packaged .pth
export TC_VIDEOS=/path/to/recording             # one directory, one video per camera
export TC_CALIB=/path/to/calibration.toml       # aniposelib layout
export TC_CAM_REGEX='cam([0-9]+)'               # capture group = camera name in the calibration
export TC_UNITS=mm                              # units of the calibration
export TC_MAX_ANIMALS=1
export TC_OUT=/path/to/predictions/recording    # chunks.txt and chunk_NNN/ go here
# Any other infer flags, e.g. the keypoint set or detector floor for your model:
export TC_EXTRA_ARGS=""                         # e.g. "--dataset-name <registry-name> --det-score 0.1"
